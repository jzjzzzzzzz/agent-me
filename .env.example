# Copy to .env. Never commit real credentials.
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

APP_NAME=My Answer Agent
APP_DESCRIPTION=A grounded question-answering agent built from your own documents.
KNOWLEDGE_DIR=knowledge
MAX_QUESTION_CHARS=8000
MAX_CONTEXT_CHARS=12000
MAX_DOCUMENT_BYTES=1000000
MAX_HISTORY_CHARS=24000
MAX_ANSWER_CHARS=50000
MAX_REQUEST_BODY_BYTES=262144
PROVIDER_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible inference provider. Leave blank for extractive local mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Comma-separated browser origins in production.
CORS_ORIGINS=http://localhost:5173
