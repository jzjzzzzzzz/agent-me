# Copy to .env. Never commit real credentials.
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=5173
# Leave blank for the same-origin Vite/Nginx proxy. Set an origin only when the
# browser must call an independently hosted API.
VITE_API_BASE_URL=

APP_NAME=Agent-Me
APP_DESCRIPTION=Build, inspect, and evaluate auditable role-based multi-agent RAG workflows.
KNOWLEDGE_DIR=knowledge
MAX_QUESTION_CHARS=8000
MAX_CONTEXT_CHARS=12000
# Per-file limit, followed by whole-corpus document-count and byte limits.
MAX_DOCUMENT_BYTES=1000000
MAX_KNOWLEDGE_DOCUMENTS=256
MAX_KNOWLEDGE_BYTES=16000000
MAX_HISTORY_CHARS=24000
MAX_ANSWER_CHARS=50000
# Complete decoded upstream HTTP response limit; enforced before JSON parsing.
MAX_PROVIDER_RESPONSE_BYTES=2000000
MAX_REQUEST_BODY_BYTES=262144
PROVIDER_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible inference provider. Leave blank for extractive local mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Comma-separated browser origins in production.
CORS_ORIGINS=http://localhost:5173
